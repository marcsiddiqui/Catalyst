        </div>
        <div class="col-md-9">
            @await Html.PartialAsync("_SearchableSelect", new SearchableSelectModel { FieldName = nameof(Model.Nationality), FieldId = Html.IdFor(model => model.Nationality), Placeholder = T("Admin.Common.Select").Text, Items = Model.AvailableNationalities, SelectedValue = Model.Nationality.ToString(), Category = GenericDropdownEntity.Nationality.ToString() })
            <span asp-validation-for="Nationality"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="Religion" />
        </div>
        <div class="col-md-9">
            @await Html.PartialAsync("_SearchableSelect", new SearchableSelectModel { FieldName = nameof(Model.Religion), FieldId = Html.IdFor(model => model.Religion), Placeholder = T("Admin.Common.Select").Text, Items = Model.AvailableReligions, SelectedValue = Model.Religion.ToString(), Category = GenericDropdownEntity.Religion.ToString() })
            <span asp-validation-for="Religion"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="BloodGroup" />
        </div>
        <div class="col-md-9">
            @await Html.PartialAsync("_SearchableSelect", new SearchableSelectModel { FieldName = nameof(Model.BloodGroup), FieldId = Html.IdFor(model => model.BloodGroup), Placeholder = T("Admin.Common.Select").Text, Items = Model.AvailableBloodGroups, SelectedValue = Model.BloodGroup.ToString(), Category = GenericDropdownEntity.BloodGroup.ToString() })
            <span asp-validation-for="BloodGroup"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="Caste" />
        </div>
        <div class="col-md-9">
            @await Html.PartialAsync("_SearchableSelect", new SearchableSelectModel { FieldName = nameof(Model.Caste), FieldId = Html.IdFor(model => model.Caste), Placeholder = T("Admin.Common.Select").Text, Items = Model.AvailableCastes, SelectedValue = Model.Caste.ToString(), Category = GenericDropdownEntity.Caste.ToString() })
            <span asp-validation-for="Caste"></span>
