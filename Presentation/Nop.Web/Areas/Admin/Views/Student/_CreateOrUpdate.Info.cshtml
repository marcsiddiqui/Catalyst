        </div>
        <div class="col-md-9">
            @await Html.PartialAsync("_SearchableSelect", new SearchableSelectModel { FieldName = nameof(Model.BirthCity), FieldId = Html.IdFor(model => model.BirthCity), Placeholder = T("Admin.Common.Select").Text, Items = Model.AvailableBirthCities, SelectedValue = Model.BirthCity.ToString(), Category = GenericDropdownEntity.BirthCity.ToString() })
            <span asp-validation-for="BirthCity"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="MontherTongue" />
        </div>
        <div class="col-md-9">
            @await Html.PartialAsync("_SearchableSelect", new SearchableSelectModel { FieldName = nameof(Model.MontherTongue), FieldId = Html.IdFor(model => model.MontherTongue), Placeholder = T("Admin.Common.Select").Text, Items = Model.AvailableMotherTongues, SelectedValue = Model.MontherTongue.ToString(), Category = GenericDropdownEntity.MotherTounge.ToString() })
