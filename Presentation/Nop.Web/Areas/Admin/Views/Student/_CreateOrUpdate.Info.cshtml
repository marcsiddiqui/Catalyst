        </div>
        <div class="col-md-9">
            <nop-editor asp-for="FirstName" />
            <span asp-validation-for="FirstName"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="MiddleName" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="MiddleName" />
            <span asp-validation-for="MiddleName"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="LastName" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="LastName" />
            <span asp-validation-for="LastName"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="CNIC" />
        </div>
        <div class="col-md-9">
            @await Html.PartialAsync("_CnicInput", new CnicInputModel { FieldName = nameof(Model.CNIC), FieldId = Html.IdFor(model => model.CNIC), Value = Model.CNIC })
            <span asp-validation-for="CNIC"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="DateOfBirth" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="DateOfBirth" />
            <span asp-validation-for="DateOfBirth"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="PhoneNumber" />
        </div>
        <div class="col-md-9">
            @await Html.PartialAsync("_PhoneNumberInput", new PhoneNumberInputModel { FieldName = nameof(Model.PhoneNumber), FieldId = Html.IdFor(model => model.PhoneNumber), Value = Model.PhoneNumber })
            <span asp-validation-for="PhoneNumber"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            @T("Admin.Configuration.Students.Fields.PictureId")
        </div>
        <div class="col-md-9">
            <div class="d-flex align-items-start">
                <div class="border rounded bg-light mr-3 d-flex align-items-center justify-content-center" style="width:120px;height:140px;overflow:hidden;">
                    @{
                        var studentPicturePreviewUrl = !string.IsNullOrWhiteSpace(Model.TemporaryPictureUrl) ? Model.TemporaryPictureUrl : Model.PictureUrl;
                    }
                    <img id="student-picture-preview" src="@studentPicturePreviewUrl" alt="" style="@(string.IsNullOrWhiteSpace(studentPicturePreviewUrl) ? "display:none;" : "")max-width:100%;max-height:100%;" />
                    <span id="student-picture-empty" class="text-muted small" style="@(string.IsNullOrWhiteSpace(studentPicturePreviewUrl) ? "" : "display:none;")">@T("Admin.Common.No")</span>
                </div>
                <div class="flex-grow-1">
                    <div class="mb-2">
                        <a id="student-picture-view" href="@(studentPicturePreviewUrl ?? "#")" class="btn btn-default btn-sm" target="_blank" style="@(string.IsNullOrWhiteSpace(studentPicturePreviewUrl) ? "display:none" : "")">
                            <i class="far fa-eye"></i>
                            @T("Admin.Common.View")
                        </a>
                        <button type="button" id="student-picture-remove" class="btn btn-danger btn-sm ml-2" style="@((Model.PictureId > 0 || !string.IsNullOrWhiteSpace(Model.TemporaryPicturePath)) ? "" : "display:none")">
                            <i class="far fa-trash-can"></i>
                            @T("Admin.Common.Delete")
                        </button>
                    </div>
                    <input type="file" id="student-picture-upload" name="StudentPictureFile" accept="image/*" />
                </div>
            </div>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="PreviousSchoolId" />
        </div>
        <div class="col-md-9">
            @await Html.PartialAsync("_SearchableSelect", new SearchableSelectModel { FieldName = nameof(Model.PreviousSchoolId), FieldId = Html.IdFor(model => model.PreviousSchoolId), Placeholder = T("Admin.Common.Select").Text, Items = Model.AvailablePreviousSchools, SelectedValue = Model.PreviousSchoolId.ToString(), Category = GenericDropdownEntity.PreviousSchoolName.ToString() })
            <span asp-validation-for="PreviousSchoolId"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="IdentificationMark" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="IdentificationMark" />
            <span asp-validation-for="IdentificationMark"></span>
        </div>
    </div>
    <div class="form-group row">
