    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="IsActive" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="IsActive" />
            <span asp-validation-for="IsActive"></span>
        </div>
    </div>
</div>

<script asp-location="Footer">
    $(function () {
        var studentPicturePond;

        function updateStudentPicture(data) {
            var pictureId = data.pictureId || 0;
            var previewUrl = data.previewUrl || '';
            var hasPicture = pictureId > 0 && previewUrl;

            $('#@Html.IdFor(model => model.PictureId)').val(pictureId);
            $('#student-picture-preview')
                .attr('src', hasPicture ? previewUrl : '')
                .toggle(hasPicture);
            $('#student-picture-empty').toggle(!hasPicture);
            $('#student-picture-view').attr('href', hasPicture ? previewUrl : '#').toggle(hasPicture);
            $('#student-picture-remove').toggle(hasPicture);
        }

        function previewSelectedStudentPicture(file) {
            if (!file) {
                return;
            }

            var reader = new FileReader();
            reader.onload = function (event) {
                $('#student-picture-preview')
                    .attr('src', event.target.result)
                    .show();
                $('#student-picture-empty').hide();
                $('#student-picture-view').attr('href', event.target.result).show();
                $('#student-picture-remove').show();
                $('#@Html.IdFor(model => model.RemovePicture)').val('False');
                $('#@Html.IdFor(model => model.TemporaryPicturePath)').val('');
                $('#@Html.IdFor(model => model.TemporaryPictureFileName)').val('');
            };

            reader.readAsDataURL(file);
        }

        function initStudentPictureUploader() {
            if (studentPicturePond) {
                return;
            }

            if (!window.FilePond) {
                setTimeout(initStudentPictureUploader, 100);
                return;
            }

            studentPicturePond = FilePond.create(document.querySelector('#student-picture-upload'), {
                credits: false,
                allowMultiple: false,
                maxFiles: 1,
                acceptedFileTypes: ['image/*'],
                storeAsFile: true,
                labelIdle: '@T("Common.FileUploader.DropFiles") / <span class="filepond--label-action">@T("Common.FileUploader.Browse")</span>',
                labelFileProcessing: '@T("Common.FileUploader.Processing")'
            });

            studentPicturePond.on('addfile', function (error, fileItem) {
                if (error || !fileItem) {
                    return;
                }

                previewSelectedStudentPicture(fileItem.file);
            });
        }

        $('#student-picture-remove').on('click', function () {
            $('#@Html.IdFor(model => model.RemovePicture)').val('True');
            $('#@Html.IdFor(model => model.TemporaryPicturePath)').val('');
            $('#@Html.IdFor(model => model.TemporaryPictureFileName)').val('');
            updateStudentPicture({});
            if (studentPicturePond) {
                studentPicturePond.removeFiles();
            }
        });

        initStudentPictureUploader();
    });
</script>
